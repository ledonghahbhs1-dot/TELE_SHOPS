# Original AGY shop bot. SHOP_BOT_TOKEN takes priority over BOT_TOKEN.
BOT_TOKEN=
ADMIN_ID=6571486853
# Attach a Railway Volume at /data before deploying.
SHOP_DATA_DIR=/data
# Plisio API key belongs on Wolfmod Vercel, never on Railway.
# Optional extra payment method: USDT BEP20 via QR of the wallet address. OFF by default.
# The wallet address, amount and confirmation all come from the Wolfmod web (TG_BEP20_* on Vercel); nothing about the
# wallet is configured here. Turn on only after the web side is deployed and enabled.
BEP20_ENABLED=0
