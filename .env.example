# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram user ID(s) allowed to use admin commands (/stock, /orders, /addlinks), comma-separated
OWNER_IDS=123456789

# Only these groups may keep the bot (empty = leave every group).
# Start a private chat with the bot first to receive rejected group IDs.
ALLOWED_GROUP_IDS=

# SQLite database path
DATABASE_PATH=/app/data/shop.db

# --- Product ---
PRODUCT_NAME=Gemini / Google One Offer Link
PRICE_VND=25000
ORDER_EXPIRE_MINUTES=15

# --- VietQR bank details (receiving account) ---
BANK_BIN=970416
BANK_NAME=ACB
ACCOUNT_NO=68986683
ACCOUNT_NAME=LE DONG HA

# --- SePay (my.sepay.vn) API token for this bank account, used to auto-confirm transfers ---
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=

# Seconds between background payment checks
POLL_INTERVAL_SEC=15
