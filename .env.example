# Original AGY shop bot. SHOP_BOT_TOKEN takes priority over BOT_TOKEN.
BOT_TOKEN=
ADMIN_ID=6571486853
# Attach a Railway Volume at /data before deploying.
SHOP_DATA_DIR=/data
# Plisio API key belongs on Wolfmod Vercel, never on Railway.
# Optional extra payment method: USDT BEP20 via QR of the wallet address. OFF by default.
# The wallet address, amount and confirmation all come from the Wolfmod web (TG_BEP20_* on Vercel); nothing about the
# wallet is configured here. Turn on only after the web side is deployed and enabled.
BEP20_ENABLED=0

# Main menu extras. Both optional.
# COMMUNITY_URL: Telegram community link (must start with https://t.me/); empty = no "Community" button.
COMMUNITY_URL=
# WALLET_ENABLED=1 shows the "My Wallet" button (placeholder until the web link feature exists). OFF by default.
WALLET_ENABLED=0
# The wallet screen calls the web with signed requests: WOLFMOD_API_SECRET must equal TG_BOT_API_SECRET on Vercel
# (32+ chars; set it only in Railway variables, never here) and the web needs TG_WALLET_ENABLED=1.
# WOLFMOD_API_URL defaults to https://www.wolfmod.xyz.
