# Original AGY shop bot. SHOP_BOT_TOKEN takes priority over BOT_TOKEN.
BOT_TOKEN=
ADMIN_ID=6571486853
# Attach a Railway Volume at /data before deploying.
SHOP_DATA_DIR=/data
# Plisio API key belongs on Wolfmod Vercel, never on Railway.
# Optional extra payment method: USDT BEP20 via QR of the wallet address. OFF by default.
# The wallet address, amount and confirmation all come from the Wolfmod web (TG_BEP20_* on Vercel); nothing about the
# wallet is configured here. Turn on only after the web side is deployed and enabled.
BEP20_ENABLED=0

# Optional extra payment method: USDT via Binance Pay (customer sends the exact price, then pastes the order ID). OFF by default.
# The Binance Pay ID, amount and verification all come from the Wolfmod web (BINANCE_PAY_* on Vercel); nothing about it is
# configured here. Turn on only after the web side is deployed and enabled.
BINANCE_PAY_ENABLED=0

# Main menu extras. Both optional.
# COMMUNITY_URL: Telegram community link (must start with https://t.me/); empty = no "Community" button.
COMMUNITY_URL=
# WALLET_ENABLED=1 turns on the bot's OWN wallet ("My Wallet": balance + history; top-up / pay-with-wallet come later).
# OFF by default. It refuses to turn on while running on Railway unless SHOP_DATA_DIR is inside the mounted Volume
# (RAILWAY_VOLUME_MOUNT_PATH), because the balances live in the bot's SQLite file and would vanish on each deploy.
WALLET_ENABLED=0
# WOLFMOD_API_URL defaults to https://www.wolfmod.xyz.
