# Required: new Telegram token from BotFather (revoke the old exposed token).
BOT_TOKEN=
# Required: Telegram user ID(s) of the owner, comma-separated.
OWNER_IDS=
# Required: same value as TG_BOT_API_SECRET on Wolfmod's Vercel project.
WOLFMOD_API_SECRET=

WOLFMOD_API_URL=https://www.wolfmod.xyz
PRODUCT_SKU=gemini_plus
POLL_INTERVAL_SEC=15

# Empty = leave every group; private customers can still shop.
ALLOWED_GROUP_IDS=
